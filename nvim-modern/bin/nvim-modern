#!/bin/sh
set -eu

nvim_bin="${NVIM_MODERN_NVIM:-$HOME/.local/opt/nvim-0.12.4/bin/nvim}"

if [ ! -x "$nvim_bin" ]; then
  printf 'nvim-modern: Neovim 0.12.4 not found at %s\n' "$nvim_bin" >&2
  printf 'Set NVIM_MODERN_NVIM to the Neovim 0.12.4 executable.\n' >&2
  exit 1
fi

NVIM_APPNAME=nvim-modern exec "$nvim_bin" "$@"
